{
  "$schema": "https://raw.githubusercontent.com/daxlib/daxlib/refs/heads/main/schemas/manifest/1.0.0/manifest.1.0.0.schema.json",
  "id": "EG.TTest",
  "version": "1.0.0",
  "authors": "ErickOliverG",
  "description": "Two-sample Student's t-test returning the two-tailed p-value, to tell whether the difference between the means of two groups is real or could be due to chance. Supports Welch (unequal variances, default) and pooled (equal variances) tests, with exact fractional degrees of freedom.",
  "tags": "DAX,Statistics,TTest,Hypothesis,PValue,Welch",
  "releaseNotes": "Initial release.",
  "projectUrl": "https://github.com/ErickOliverG/daxlib",
  "readme": "/README.md"
}
