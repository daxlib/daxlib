/// Blinkcircle.AlertIndicator — Bibliothèque TMDL universelle
/// Version      : 1.0.0
/// Compatibilité: Power BI / Tabular Editor
/// Description  : KPI SVG with blinking alert badge
table SVG_Utils

    measure SVG_Data_URL =
        "data:image/svg+xml;utf8,"

    measure SVG_Start =
        "<svg height='55' width='200' xmlns='http://www.w3.org/2000/svg'>"

    measure SVG_End =
        "</svg>"

    measure SVG_Status_Badge =

        VAR _Color = [Status_Color]
        VAR _Label = [Status_]

        VAR _Body =
            "<rect height='50' width='195' x='2' y='2'/>" &
            "<text x='50%' y='50%'>" & _Label & "</text>"

        VAR _No_Blink =
            "<style>" &
                "rect{" &
                    "rx:15;ry:15;" &
                    "stroke:" & _Color & ";" &
                    "stroke-width:2;" &
                    "fill:" & _Color & ";" &
                    "fill-opacity:0.3;" &
                "}" &
                "text{" &
                    "font-family:'Segoe UI';" &
                    "font-size:14px;" &
                    "fill:black;" &
                    "text-anchor:middle;" &
                    "dominant-baseline:middle;" &
                "}" &
            "</style>" &
            _Body

        VAR _Blink =
            "<style>" &
                "@keyframes blink{" &
                    "0%{fill:" & _Color & "}" &
                    "50%{fill:white}" &
                    "100%{fill:" & _Color & "}" &
                "}" &
                "rect{" &
                    "rx:15;ry:15;" &
                    "stroke:" & _Color & ";" &
                    "stroke-width:2;" &
                    "fill:" & _Color & ";" &
                    "fill-opacity:0.3;" &
                    "animation:blink 2s infinite;" &
                "}" &
                "text{" &
                    "font-family:'Segoe UI';" &
                    "font-size:14px;" &
                    "fill:black;" &
                    "text-anchor:middle;" &
                    "dominant-baseline:middle;" &
                "}" &
            "</style>" &
            _Body

        RETURN
            [SVG_Data_URL] &
            [SVG_Start] &
            IF(_Color = "#f8291e", _Blink, _No_Blink) &
            [SVG_End]
    annotation DAXLIBPackageId = "Blinkcircle"
    annotation DAXLIBPackageVersion = "1.0.0"
    annotation DAXLIBDescription = "KPI SVG Badge Utility Library with blinking alert"