{
  "$schema": "https://raw.githubusercontent.com/daxlib/daxlib/refs/heads/main/schemas/manifest/1.0.0/manifest.1.0.0.schema.json",
  "id": "DataTides.ColourContrast",
  "version": "0.1.0",
  "authors": "Juls-BI",
  "description": "Library of colour accessibility functions: WCAG relative luminance, squared Euclidean colour distance, and APCA perceptual contrast (Lc), for evaluating text/background contrast in Power BI reports.",
  "tags": "Accessibility,Colour",
  "releaseNotes": "Initial release of the DataTides.ColourContrast library, providing HexLuminance (WCAG relative luminance), ColorDistance2 (squared Euclidean distance in sRGB), and APCA_Lc (APCA perceptual contrast) for assessing colour accessibility.",
